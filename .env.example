# Public URL of the deployment, used for metadata and server-side absolute URLs.
NEXT_PUBLIC_SITE_URL=https://www.cashbridge.space
# Optional contact email, required by Trezor Connect's manifest if Trezor is used.
NEXT_PUBLIC_SUPPORT_EMAIL=

NEXT_PUBLIC_MEMOLESS_API=https://api.thorchain.org/memoless/api/v1

# THORChain aggregator, reached only through the server route /api/thorchain/v1/*.
# Server-only: never prefix the key with NEXT_PUBLIC_, never commit a real value.
THORCHAIN_API_KEY=
THORCHAIN_API_URL=https://api.thorchain.org/v1

# NEAR Intents (1Click) as a second bridge route beside THORChain: on unless set to false.
# NEXT_PUBLIC_NEAR_INTENTS=false
# NEXT_PUBLIC_NEAR_INTENTS_URL=https://1click.chaindefuser.com/v0
# Partner JWT from the 1Click Partner Dashboard (server-only). Without it, quotes stay keyless (+25 bps).
# Never prefix with NEXT_PUBLIC_; the browser uses /api/near-intents which adds this header.
# NEAR_INTENTS_JWT=
# Optional server-only upstream override (defaults to NEXT_PUBLIC_NEAR_INTENTS_URL / 1click.chaindefuser.com/v0).
# NEAR_INTENTS_URL=https://1click.chaindefuser.com/v0
# The Cashbridge Router's forward transfers through NEAR Intents too, where the Router has AUTO_BRIDGE_NEAR_ORDERS=true. On unless set to false.
# NEXT_PUBLIC_ROUTER_NEAR=false
# The same through ShapeShift (its BCH quotes are NEAR Intents addresses, so the Router needs AUTO_BRIDGE_NEAR_ORDERS too).
# NEXT_PUBLIC_ROUTER_SHAPESHIFT=false
# Router sales paid out through NEAR Intents or ShapeShift, where the Router has AUTO_BRIDGE_SALE_ROUTES on (the default).
# NEXT_PUBLIC_ROUTER_SALE_ROUTES=false

# BCH -> PUSD second leg (public endpoints, no secrets). Defaults shown.
NEXT_PUBLIC_CAULDRON_BROADCAST_URL=https://broadcast.cauldron.quest/broadcast
NEXT_PUBLIC_CAULDRON_INDEXER_URL=https://indexer.cauldron.quest
# Comma-separated Fulcrum (Electrum) WSS servers used to verify the BCH receipt.
NEXT_PUBLIC_BCH_ELECTRUM_URLS=wss://bch.imaginary.cash:50004
NEXT_PUBLIC_ALCHEMY_ETH_RPC_URL=
SOLANA_RPC_URL=
# WalletConnect (Reown) project ID for Paytaca, Cashonize and other WalletConnect v2 BCH wallets.
# Public (not a secret). Defaults to Cash Bridge's project; set it empty to hide the option.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
