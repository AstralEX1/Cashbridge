pragma cashscript ^0.14.0;

// Escrow for one Cashbridge Router order, second version.
//
// The order's bridge (THORChain, NEAR Intents or ShapeShift) pays its BCH here. Two keys can settle it: the Router's
// and a one-use key the customer's page made for this order, so the page can buy the token the moment the BCH lands
// and the Router finishes when the page is closed. Neither key can move a coin anywhere but to the customer: as the
// ordered CashToken (at least the coin's share of the quoted minimum) or back as BCH. Each check looks at the output
// with the same index as the coin being spent, so one output can never settle two coins.
contract RouterOrderV2(
    // The Router's public key for this order.
    pubkey router,
    // The page's one-use public key for this order (the Router's key again when the order has no page).
    pubkey page,
    // Locking bytecode of the customer's token address.
    bytes payoutLock,
    // Locking bytecode of the customer's BCH fallback address.
    bytes fallbackLock,
    // The ordered token's category, in the byte order the VM uses (explorers show it reversed).
    bytes32 token,
    // The quoted minimum for `quotedSats` of BCH, in the token's base units.
    int minTokens,
    // The BCH the bridge was quoted to pay. A smaller coin must still buy its share of the minimum, so a bridge that
    // pays a little less does not send the order back as BCH.
    int quotedSats,
    // Unix time after which anyone may send the BCH back (compared with the chain's median time).
    int refundTime
) {
    // Buys the token with the coin on Cauldron; the trade must pay the customer at least the coin's share of the minimum.
    function convert(sig signature, pubkey key) {
        require(key == router || key == page);
        require(checkSig(signature, key));
        int i = this.activeInputIndex;
        int floor = tx.inputs[i].value * minTokens / quotedSats;
        if (floor > minTokens) {
            floor = minTokens;
        }
        require(tx.outputs[i].lockingBytecode == payoutLock);
        require(tx.outputs[i].tokenCategory == token);
        require(tx.outputs[i].tokenAmount >= floor);
    }

    // Gives up on converting and returns the BCH, keeping at most 2,000 sats for the miner.
    function giveBack(sig signature, pubkey key) {
        require(key == router || key == page);
        require(checkSig(signature, key));
        int i = this.activeInputIndex;
        require(tx.outputs[i].lockingBytecode == fallbackLock);
        require(tx.outputs[i].tokenCategory == 0x);
        require(tx.outputs[i].value + 2000 >= tx.inputs[i].value);
    }

    // Once the refund time has passed, anyone can return the BCH on the same terms, so a stopped Router and a closed
    // page cannot strand it.
    function expire() {
        require(tx.time >= refundTime);
        int i = this.activeInputIndex;
        require(tx.outputs[i].lockingBytecode == fallbackLock);
        require(tx.outputs[i].tokenCategory == 0x);
        require(tx.outputs[i].value + 2000 >= tx.inputs[i].value);
    }
}
